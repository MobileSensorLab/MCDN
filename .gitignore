# Python / IDE
__pycache__
.cursor/
.idea/
.pytest_cache/
.ruff_cache/
.venv/
*.py[oc]
*.egg-info
_*
build/
dist/
wheels/
*.bundle

# Experiment outputs: track the result artifacts (metrics, configs, prediction caches) for the
# directories the paper draws on; ignore everything else under outputs/. Trained checkpoints
# (best_model.pt, ~134 MB each) are published on Hugging Face (mobilesensorlab/mcdn) and
# fetched with scripts/fetch_checkpoints.py rather than tracked here.
outputs/*
!outputs/ablation/
!outputs/ablation/_ensembles/
!outputs/crewed_displacement/
!outputs/crewed_transfer/
!outputs/decomposition/
!outputs/error_mining/
!outputs/gsd_validation/
!outputs/gsd_validation_7x/
!outputs/label_agreement/
!outputs/mask_robustness/
!outputs/soup/
!outputs/spatial_autocorr/
!outputs/spatial_context/
outputs/**/best_model.pt
outputs/**/split_summary.json
outputs/**/classification_metrics.json
outputs/ablation/.cache/
outputs/ablation/MANIFEST.json

# Include the data folder and top-level files (statistics.csv) but ignore the ~200 GB dataset within.
# data/readme/ holds README assets and stays tracked.
data/*/*
!data/readme/**